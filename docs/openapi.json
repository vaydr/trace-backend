  "components": {
    "schemas": {
      "EvidencePath": {
        "properties": {
          "nodes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Nodes"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/PathStep"
            },
            "type": "array",
            "title": "Steps"
          },
          "agreement": {
            "type": "number",
            "title": "Agreement"
          },
          "hops": {
            "type": "integer",
            "title": "Hops"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "nodes",
          "steps",
          "agreement",
          "hops"
        ],
        "title": "EvidencePath"
      },
      "GraphEdge": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "target": {
            "type": "string",
            "title": "Target"
          },
          "predicate": {
            "type": "string",
            "title": "Predicate"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "origin": {
            "type": "string",
            "enum": [
              "retrieved",
              "expansion"
            ],
            "title": "Origin"
          },
          "on_path": {
            "type": "boolean",
            "title": "On Path"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "source",
          "target",
          "predicate",
          "label",
          "score",
          "origin",
          "on_path"
        ],
        "title": "GraphEdge"
      },
      "GraphNode": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "is_topic": {
            "type": "boolean",
            "title": "Is Topic",
            "default": false
          },
          "is_answer": {
            "type": "boolean",
            "title": "Is Answer",
            "default": false
          },
          "on_path": {
            "type": "boolean",
            "title": "On Path",
            "default": false
          },
          "source_urls": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Source Urls"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "title": "GraphNode"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PathStep": {
        "properties": {
          "triple_id": {
            "type": "string",
            "title": "Triple Id"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "target": {
            "type": "string",
            "title": "Target"
          },
          "predicate": {
            "type": "string",
            "title": "Predicate"
          },
          "reversed": {
            "type": "boolean",
            "title": "Reversed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "triple_id",
          "source",
          "target",
          "predicate",
          "reversed"
        ],
        "title": "PathStep"
      },
      "QueryRequest": {
        "properties": {
          "question": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4000,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Question"
          },
          "topic_entity": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Topic Entity"
          },
          "question_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Question Id"
          },
          "k": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "K",
            "default": 50
          },
          "max_hops": {
            "type": "integer",
            "maximum": 12.0,
            "minimum": 1.0,
            "title": "Max Hops",
            "default": 8
          },
          "candidate_hops": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 3.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Candidate Hops"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "QueryRequest"
      },
      "QueryResponse": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "question": {
            "type": "string",
            "title": "Question"
          },
          "topic_entity": {
            "type": "string",
            "title": "Topic Entity"
          },
          "answer_entity": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Answer Entity"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation"
          },
          "parser_answer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parser Answer"
          },
          "parser_disagreement": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parser Disagreement"
          },
          "clauses": {
            "items": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "array",
            "title": "Clauses"
          },
          "status": {
            "type": "string",
            "enum": [
              "path_found",
              "no_path_within_budget",
              "search_incomplete",
              "no_answer",
              "answer_unresolved"
            ],
            "title": "Status"
          },
          "nodes": {
            "items": {
              "$ref": "#/components/schemas/GraphNode"
            },
            "type": "array",
            "title": "Nodes"
          },
          "edges": {
            "items": {
              "$ref": "#/components/schemas/GraphEdge"
            },
            "type": "array",
            "title": "Edges"
          },
          "highlighted_path": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EvidencePath"
              },
              {
                "type": "null"
              }
            ]
          },
          "alternative_paths": {
            "items": {
              "$ref": "#/components/schemas/EvidencePath"
            },
            "type": "array",
            "title": "Alternative Paths"
          },
          "search_complete": {
            "type": "boolean",
            "title": "Search Complete"
          },
          "states_examined": {
            "type": "integer",
            "title": "States Examined"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "question",
          "topic_entity",
          "answer_entity",
          "answer",
          "explanation",
          "parser_answer",
          "parser_disagreement",
          "clauses",
          "status",
          "nodes",
          "edges",
          "highlighted_path",
          "alternative_paths",
          "search_complete",
          "states_examined",
          "warnings"
        ],
        "title": "QueryResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
